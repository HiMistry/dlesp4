    <script type="3df7e0e47f58cd1fe38a4e6b-text/javascript">
      const myOffcanvas = document.getElementById('offcanvasMenu')
      myOffcanvas.addEventListener('show.bs.offcanvas', event => {
        get_level();
      })

      function get_level() {
        var temp_per = 'B';
        

          $.post(newURL + "ajax/get-level", 'permiso_c=' + temp_per, function(data) {
            $('#diagram-sidebar').html("");

            if (data.nivel >= 85) var color = '#4caf50';
            else if (data.nivel >= 40) var color = '#ff9800';
            else var color = '#f44336';
            var myCircle16 = Circles.create({
              id: 'diagram-sidebar',
              radius: 36,
              value: data.nivel,
              maxValue: 100,
              width: 5,
              text: data.nivel + '%',
              colors: ['#ddd', color],
              duration: 400,
              wrpClass: 'circles-wrp',
              textClass: 'color-white'
            });

            console.log(data.t_pr);
            $("#t_pr").html(data.t_pr);
          }, "json");
              }
    </script>

    
        <script type="3df7e0e47f58cd1fe38a4e6b-text/javascript">
    $(document).ready(function() {

                    $.post(newURL + "ajax/get-centros-medicos_bound", function(data) {

                //var res = JSON.parse(data);

                var mc = data.length;
                if (mc > 0) {

                    //console.log(data);

                    $.each(data, function(i, item) {
                        //console.log( data[i]['codigos']);
                    });

                    str = '';
                    if (mc > 1) str = 'Se encontraron <a href="' + newURL +
                        'renovar-carnet-de-conducir"><b>' + mc +
                        ' centros</b></a> con oferta para obtener el certificado médico.';
                    else if (mc == 1) str = 'Se encontró <a href="' + newURL +
                        'renovar-carnet-de-conducir"><b>1 centro</b></a> con oferta para obtener el certificado médico.';

                    if (str != '') {
                        $("#box_cm").html("<h5>Buscador de centros médicos:</h5>" + str);
                        $("#box_cm").show();
                        $("#box_regalo").show();
                    }
                }

            }, "json");
        
    });

    document.addEventListener('DOMContentLoaded', function() {
        const isInEnglish = localStorage.getItem('is_in_english');

        if (isInEnglish === 'true' && window.location.href !== "https://practicatest.com/temario/libros-de-conducir/driving-theory-book-in-english/31") {

            const modal = new bootstrap.Modal(document.getElementById('languageModal'));
            modal.show();

            document.getElementById('goEnglish').addEventListener('click', function() {
                window.location.href = newURL + 'en';
            });

            document.getElementById('staySpanish').addEventListener('click', function() {
                localStorage.setItem('is_in_english', 'false');
            });
        }
    });
</script>
