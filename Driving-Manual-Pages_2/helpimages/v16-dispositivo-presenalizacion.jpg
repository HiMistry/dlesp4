    $(function() {


      var nivel = 0;
      //var nivel = 40;
      if (nivel >= 85) var color = '#4caf50';
      else if (nivel >= 40) var color = '#ff9800';
      else var color = '#f44336';
      var myCircle16 = Circles.create({
        id: 'circles-1',
        radius: 65,
        value: nivel,
        maxValue: 100,
        width: 10,
        text: nivel + '%',
        colors: ['#ddd', color],
        duration: 500,
        wrpClass: 'circles-wrp',
        textClass: ''
      });

                    
              $.post(newURL + "ajax/get-send-libro", function(data) {

          if (data != '') {
            if (pais == 'ES') {
              if (lang == 'en') {
                window.location.href = newURL + "en/send_book/" + data;
              } else {
                window.location.href = newURL + "direccion-envio/" + data;
              }
            } else {
              window.location.href = newURL + "direccion-envio/" + data;
            }
          }
        }, "json");
      
      if (document.getElementById('canvas_sumtotal')) {
        var ctx = document.getElementById('canvas_sumtotal').getContext('2d');
        var myChart = new Chart(ctx, {
          options: {
            responsive: true,
            maintainAspectRatio: true
          },
          type: 'line',
          data: {
            labels: [],
            datasets: [{
              label: lang == 'en' ? 'Number of exams' : 'Nº preguntas acumuladas',
              data: [],
              backgroundColor: "rgba(52, 101, 174,0.4)"
            }]
          }
        });
      }

      if (document.getElementById('canvas_mediafallos')) {
        var ctx_error = document.getElementById('canvas_mediafallos').getContext('2d');
        var myChart_error = new Chart(ctx_error, {
          options: {
            responsive: true,
            maintainAspectRatio: true
          },
          type: 'line',
          data: {
            labels: [],
            datasets: [{
              label: lang == 'en' ? 'Average of errors' : 'Media de fallos',
              data: [],
              backgroundColor: "rgba(204, 51, 51,0.4)"
            }]
          }
        });
      }


      setTimeout(function() {
        $('.progress-bar').each(function() {
          var me = $(this);
          var perc = me.attr("aria-valuenow");
          var current_perc = 0;

          var progress = setInterval(function() {
            if (current_perc == '0') {
              me.css('width', '0%');
            }

            if (current_perc >= perc) {
              clearInterval(progress);
            } else {
              current_perc += 1;
              me.css('width', (current_perc) + '%');
            }

            if (current_perc > 9) {
              me.text((current_perc) + '%');
            }
          }, 40);

        });

      }, 280);

    });
  </script>


